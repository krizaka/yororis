{
  "name": "@yororis/web",
  "version": "0.0.1",
  "private": true,
  "description": "The Yororis member space and organisation console \u2014 runs on 127.0.0.1 with a fictional cast, never deployed (construction mode).",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3400",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3400",
    "lint": "eslint . --max-warnings 0 && krizaka-i18n check messages && krizaka-i18n scan app components --allow Yororis,YORORIS,Krizaka,KRIZAKA --skip /app/api/",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e/moment.mjs && node tests/e2e/crawl.mjs"
  },
  "dependencies": {
    "@krizaka/fonts": "0.2.0",
    "@krizaka/i18n": "^0.2.1",
    "@krizaka/icons": "^0.5.1",
    "@krizaka/query": "^0.2.1",
    "@krizaka/tailwind": "^3.25.0",
    "@krizaka/tokens": "^3.25.0",
    "@krizaka/ui": "^3.25.0",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@krizaka/config": "^0.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.0",
    "playwright": "^1.64.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22"
  }
}
